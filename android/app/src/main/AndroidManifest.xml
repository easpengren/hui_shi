<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network access for Piper model downloads -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Read files from external storage (Android < 13) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- Audio focus / media playback -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Required from Android 14 for a mediaPlayback foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- Required from Android 13, and load-bearing rather than cosmetic. A
         mediaPlayback foreground service *is* its visible notification: with
         this permission ungranted the notification is suppressed, the service
         never counts as foreground, and Android suspends the process when the
         screen goes off. Read-aloud stops mid-sentence, and the reading
         position goes with it because the process dies before the debounced
         save finishes. audio_service declares no permissions of its own, so
         this has to be here. Declaring it is necessary but NOT sufficient —
         it is a runtime permission; see playback/notification_permission.dart. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Self-update: install the downloaded APK via the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <application
        android:label="Lu Ji"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Share target: text sent from another app is read aloud.
                 Confucius shares extracted article prose here rather than
                 building a second, worse reader beside this one. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <!-- The same share, handed over as a content:// URI instead of an
                 extra. A long chapter cannot travel as EXTRA_TEXT: the Binder
                 transaction budget is about 1 MB, and 225,034 characters of the
                 Platform Sutra threw TransactionTooLargeException and killed the
                 process before Flutter started. A URI is a handle, so length
                 stops mattering. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content" android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- audio_service: the media session and, crucially, the foreground
             service that keeps read-aloud running with the screen off. Also
             gives lock-screen, notification and headset controls. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
        <!-- ota_update (in-app self-update): its FileProvider + install-result
             receiver. Required by the plugin in 7.x — without the provider,
             FileProvider.getUriForFile crashes at install time. -->
        <provider
            android:name="sk.fourq.otaupdate.OtaUpdateFileProvider"
            android:authorities="${applicationId}.ota_update_provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>
        <receiver
            android:name="sk.fourq.otaupdate.InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="${applicationId}.ACTION_INSTALL_COMPLETE" />
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
